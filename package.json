{
  "name": "fusion",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy/localhost.proxy.json -o --configuration development",
    "dev": "npm run start:eagle-dev",
    "build": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production --output-path=dist/www --base-href=/",
    "build:server": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng run fusion:server:production",
    "prerender": "node generate-sitemap.js && node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng run fusion:prerender:production",
    "postbuild": "npm run compress:gzip && npm run compress:brotli",
    "compress:brotli": "gzipper --brotli --gzip-level=9 --verbose ./dist/www",
    "compress:gzip": "gzipper --verbose --gzip-level=9 ./dist/www",
    "build:local": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration production",
    "build:optimized": "bash build-optimized.sh",
    "build:css-purge": "npm run tailwind:prod && npm run build -- --optimization",
    "analyze:bundle": "npx webpack-bundle-analyzer dist/www/fusion/stats.json",
    "build:analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/www/fusion/stats.json",
    "build:fast": "ng build --configuration development --source-map=false --vendor-chunk",
    "start:prod": "ng serve --configuration production --source-map=false",
    "preload-check": "ng build --configuration production --stats-json && npx bundlesize",
    "serve:prod": "http-server -p 8080 -c-1 dist/www",
    "analyze": "webpack-bundle-analyzer ./dist/www/fusion/stats.json",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "tailwind": "npx tailwindcss -i src/tailwind-build.scss -o src/styles/tailwind-output.css --watch",
    "tailwind:build": "npx tailwindcss -i src/tailwind-build.scss -o src/styles/tailwind-output.css",
    "tailwind:prod": "npx tailwindcss -i src/tailwind-build.scss -o src/styles/tailwind-output.css --minify",
    "prestart": "echo 'Starting development server...'",
    "start:fast": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy/localhost.proxy.json -o --configuration development",
    "bundle:report": "source-map-explorer dist/www/fusion/**/*.js",
    "test": "jest",
    "test-watch": "jest --watch",
    "test-coverage": "jest  --coverage",
    "jest-cache": " jest --clearCache",
    "testRunner": "jest --testRunner='jest-circus/runner'"
  },
  "private": true,
