{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "project",
  "projects": {
    "fusion": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ws",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/www/fusion",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/favicon.png",
              "src/fusion-assets",
              "src/fusion-assets/icons/",
              "src/fusion-assets/images/",
              "src/robots.txt",
              "src/sitemap.xml",
              "src/.htaccess",
              {
                "glob": "**/*.*",
                "input": "./node_modules/@aastrika_npmjs/discussions-ui-v8/assets",
                "output": "./assets/discussion-ui"
              },
              {
                "glob": "**/*.*",
                "input": "./node_modules/@aastrika_npmjs/competency-web/assets",
                "output": "./assets/comptency"
              },
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*.js",
                "input": "src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/bleeding-edge/",
                "output": "/bleeding-edge/"
              },
              {
                "glob": "theme-igot.scss",
                "input": "src/themes/",
                "output": "/assets/"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "styles": [
              "node_modules/tailwindcss/dist/utilities.min.css",
              "node_modules/video.js/dist/video-js.min.css",
              "node_modules/vis-network/dist/vis-network.min.css",
              "node_modules/tailwindcss/dist/components.min.css",
              "node_modules/videojs-markers/dist/videojs.markers.min.css",
              "src/styles/libraries.scss",
              "node_modules/material-icons/iconfont/material-icons.scss",
              "src/styles/mat-typography.scss",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles/styles.scss",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/shepherd.js/dist/css/shepherd.css",
              "node_modules/@aastrika_npmjs/discussions-ui-v8/assets/styles/global.scss",
              "node_modules/@aastrika_npmjs/competency-web/assets/styles/global.scss",
              "src/themes/theme-igot.scss",
              "node_modules/pdfjs-dist/web/pdf_viewer.css",
              "src/fusion-assets/fonts/poppins/stylesheet.css",
              "node_modules/typeface-roboto/index.css",
              "src/styles.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.min.js",
              "src/fusion-assets/telemetry.min.js",
              "node_modules/shepherd.js/dist/js/shepherd.min.js",
              "node_modules/jspdf-autotable/dist/jspdf.plugin.autotable.js"
            ],
            "aot": true,
            "vendorChunk": false,
            "extractLicenses": true,
            "buildOptimizer": false,
            "sourceMap": {
              "scripts": true,
              "styles": true,
              "vendor": true
            },
            "optimization": true,
            "namedChunks": false
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true,
              "aot": false,
              "buildOptimizer": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "allowedCommonJsDependencies": [
                "@angular/compiler",
                "moment"
              ]
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "vendorChunk": false,
              "buildOptimizer": false,
              "preserveSymlinks": true,
              "allowedCommonJsDependencies": [
                "@angular/compiler",
                "videojs-markers",
                "events",
                "qrcode",
                "dayjs",
                "file-saver",
                "moment",
                "lodash",
                "@project-sunbird/client-services",
                "@aastrika_npmjs/discussions-ui-v8",
                "rxjs"
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "18mb",
                  "maximumError": "18mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kb",
                  "maximumError": "400kb"
                },
                {
                  "type": "anyComponentStyle",
                  "name": "org-home.component",
                  "maximumWarning": "250kb"
                }
              ],
              "serviceWorker": false,
              "ngswConfigPath": "ngsw-config.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 3000,
            "browserTarget": "fusion:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "fusion:build:production"
            },
            "development": {
              "browserTarget": "fusion:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "@ws-widget/resolver": {
      "projectType": "library",
      "root": "library/ws-widget/resolver",
      "sourceRoot": "library/ws-widget/resolver/src",
      "prefix": "ws-resolver",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "library/ws-widget/resolver/tsconfig.lib.json",
            "project": "library/ws-widget/resolver/ng-package.json"
          }
        }
      }
    },
    "@ws-widget/collection": {
      "projectType": "library",
      "root": "library/ws-widget/collection",
      "sourceRoot": "library/ws-widget/collection/src",
      "prefix": "ws-widget",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "library/ws-widget/collection/tsconfig.lib.json",
            "project": "library/ws-widget/collection/ng-package.json"
          }
        }
      }
    },
    "@ws-widget/utils": {
      "projectType": "library",
      "root": "library/ws-widget/utils",
      "sourceRoot": "library/ws-widget/utils/src",
      "prefix": "ws-utils",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "library/ws-widget/utils/tsconfig.lib.json",
            "project": "library/ws-widget/utils/ng-package.json"
          }
        }
      }
    },
    "@ws/app": {
      "projectType": "library",
      "root": "project/ws/app",
      "sourceRoot": "project/ws/app/src",
      "prefix": "ws-app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "project/ws/app/tsconfig.lib.json",
            "project": "project/ws/app/ng-package.json"
          }
        }
      }
    },
    "@ws/author": {
      "projectType": "library",
      "root": "project/ws/author",
      "sourceRoot": "project/ws/author/src",
      "prefix": "ws-author",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "project/ws/author/tsconfig.lib.json",
            "project": "project/ws/author/ng-package.json"
          }
        }
      }
    },
    "@ws/viewer": {
      "projectType": "library",
      "root": "project/ws/viewer",
      "sourceRoot": "project/ws/viewer/src",
      "prefix": "viewer",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "project/ws/viewer/tsconfig.lib.json",
            "project": "project/ws/viewer/ng-package.json"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  }
}